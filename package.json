{
    "name": "log-viewer",
    "version": "1.0.0",
    "description": "An Electron application with Vue 3 and Vuetify",
    "main": "main.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
        "dev:frontend": "vite",
        "dev:backend": "node main.js",
        "build": "vite build",
        "preview": "vite preview",
        "start": "npm run build && node main.js",
        "test:socket": "node Test/test-socket-client.js"
    },
    "keywords": [
        "electron",
        "vue3",
        "vuetify",
        "desktop-app"
    ],
    "author": "Your Name",
    "license": "MIT",
    "devDependencies": {
        "@vitejs/plugin-vue": "^4.5.0",
        "concurrently": "^8.2.2",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "@mdi/font": "^7.3.67",
        "chart.js": "^4.5.1",
        "express": "^4.18.2",
        "pinia": "^3.0.3",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "vue": "^3.3.8",
        "vuetify": "^3.4.7"
    },
    "build": {
        "appId": "com.example.log-viewer",
        "productName": "Log Viewer",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "main.js",
            "preload.js",
            "ChainHandler.js",
            "DetectJSONHandler.js",
            "DetectLabelHandler.js",
            "DetectTypeHandler.js",
            "DetectVariablesHandler.js",
            "MessageBatcher.js",
            "PerformanceProfiler.js",
            "formatMessage.js",
            "inputs/**",
            "node_modules/**/*"
        ],
        "mac": {
            "category": "public.app-category.productivity"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}